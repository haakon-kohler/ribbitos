# Copy to a file outside the repository (it will hold a key), fill in, and pass it to provision.sh.
RIBBIT_PROVIDER=claude          # demo, openclaw, openai or claude
RIBBIT_TOKEN=                   # API key, or for OpenClaw the gateway (or proxy) token
RIBBIT_BASE_URL=                # optional; required for openclaw, e.g. http://192.168.1.20:18789/v1
RIBBIT_MODEL=                   # optional; each provider has a default
RIBBIT_TEXT_SIZE=               # optional; small, medium (the default) or large
RIBBIT_PIN=                     # optional; a lock screen PIN (4+ digits). Empty: swipe to unlock
