<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/settings"
            android:textColor="@color/fg"
            android:textIsSelectable="false"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="12dp">

            <TextView style="@style/Label" android:text="@string/provider" />

            <RadioGroup
                android:id="@+id/provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/provider_demo" style="@style/Segment" android:text="@string/provider_demo" />
                <RadioButton android:id="@+id/provider_openclaw" style="@style/Segment" android:text="@string/provider_openclaw" />
                <RadioButton android:id="@+id/provider_openai" style="@style/Segment" android:text="@string/provider_openai" />
                <RadioButton android:id="@+id/provider_claude" style="@style/Segment" android:text="@string/provider_claude" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/label_url" style="@style/Label" android:text="@string/label_url_api" android:textIsSelectable="false" android:labelFor="@id/base_url" />
                <EditText
                    android:id="@+id/base_url"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <TextView android:id="@+id/label_token" style="@style/Label" android:text="@string/label_key" android:textIsSelectable="false" android:labelFor="@id/token" />
                <EditText
                    android:id="@+id/token"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <TextView android:id="@+id/label_model" style="@style/Label" android:text="@string/label_model" android:textIsSelectable="false" android:labelFor="@id/model" />
                <EditText
                    android:id="@+id/model"
                    style="@style/Field"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </LinearLayout>

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent"
                android:text="@string/save"
                android:textColor="@color/bg" />

            <TextView
                android:id="@+id/help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dim"
                android:textIsSelectable="false"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
