<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView style="@style/Label" android:text="@string/base_url" />
        <EditText
            android:id="@+id/base_url"
            style="@style/Field"
            android:importantForAutofill="no"
            android:hint="@string/base_url_hint"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="@string/token" />
        <EditText
            android:id="@+id/token"
            style="@style/Field"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="@string/agent" />
        <EditText
            android:id="@+id/agent"
            style="@style/Field"
            android:importantForAutofill="no"
            android:hint="@string/agent_hint"
            android:inputType="text" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:text="@string/save"
            android:textColor="@color/bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_help"
            android:textColor="@color/dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
